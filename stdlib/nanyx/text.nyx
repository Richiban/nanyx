module text

-- nanyx/text: functions on strings.
--
-- Strings are UTF-8. This first slice works byte by byte: `length` counts bytes (not grapheme
-- clusters, as the language docs promise), `toUpper` and `toLower` only change ASCII letters and
-- `trim` only strips ASCII whitespace. Multi-byte characters pass through every function unchanged.
--
-- Everything here is written over four compiler intrinsics: `__nanyx_string_length`,
-- `__nanyx_string_byte_at`, `__nanyx_string_slice` and `__nanyx_string_from_byte`; `split` also
-- builds its result with `__nanyx_list_cons`. `++` (concatenation) and `==` on strings are language operators.

-- The number of bytes in `s`.
export def length: string -> int = { s -> __nanyx_string_length(s) }

-- The `count` bytes of `s` starting at byte `start`. Out-of-range values are clamped, so the result
-- is never longer than what `s` actually holds.
export def substring: (string, int, int) -> string = { s, start, count ->
  __nanyx_string_slice(s, start, count)
}

-- Whether `s` begins with `prefix`.
export def startsWith: (string, string) -> bool = { s, prefix ->
  if length(prefix) > length(s)
  then false
  else substring(s, 0, length(prefix)) == prefix
}

-- Whether `s` ends with `suffix`.
export def endsWith: (string, string) -> bool = { s, suffix ->
  if length(suffix) > length(s)
  then false
  else substring(s, length(s) - length(suffix), length(suffix)) == suffix
}

-- The byte index of the first occurrence of `needle` in `s` at or after `from`, or -1.
def indexFrom: (string, string, int) -> int = { s, needle, from ->
  if from + length(needle) > length(s)
  then -1
  else if substring(s, from, length(needle)) == needle
  then from
  else indexFrom(s, needle, from + 1)
}

-- Whether `needle` occurs anywhere in `s`.
export def contains: (string, string) -> bool = { s, needle -> indexFrom(s, needle, 0) >= 0 }

def upperByte: int -> int = { b -> if b >= 97 then (if b <= 122 then b - 32 else b) else b }

def lowerByte: int -> int = { b -> if b >= 65 then (if b <= 90 then b + 32 else b) else b }

def toUpperFrom: (string, int, string) -> string = { s, i, acc ->
  if i >= length(s)
  then acc
  else toUpperFrom(s, i + 1, acc ++ __nanyx_string_from_byte(upperByte(__nanyx_string_byte_at(s, i))))
}

def toLowerFrom: (string, int, string) -> string = { s, i, acc ->
  if i >= length(s)
  then acc
  else toLowerFrom(s, i + 1, acc ++ __nanyx_string_from_byte(lowerByte(__nanyx_string_byte_at(s, i))))
}

-- `s` with every ASCII letter upper-cased.
export def toUpper: string -> string = { s -> toUpperFrom(s, 0, "") }

-- `s` with every ASCII letter lower-cased.
export def toLower: string -> string = { s -> toLowerFrom(s, 0, "") }

-- Whether byte `b` is a space, tab, line feed or carriage return.
def isWhitespace: int -> bool = { b -> b == 32 || b == 9 || b == 10 || b == 13 }

-- The index of the first non-whitespace byte at or after `i` (or the length of `s`).
def skipWhitespace: (string, int) -> int = { s, i ->
  if i < length(s)
  then (if isWhitespace(__nanyx_string_byte_at(s, i)) then skipWhitespace(s, i + 1) else i)
  else i
}

-- The index just past the last non-whitespace byte before `stop` (or 0).
def trimEnd: (string, int) -> int = { s, stop ->
  if stop > 0
  then (if isWhitespace(__nanyx_string_byte_at(s, stop - 1)) then trimEnd(s, stop - 1) else stop)
  else stop
}

-- `s` without leading and trailing whitespace.
export def trim: string -> string = { s ->
  def start = skipWhitespace(s, 0)
  def stop = trimEnd(s, length(s))
  if stop > start then substring(s, start, stop - start) else ""
}

-- `s` repeated `times` times (the empty string when `times` is zero or negative).
export def repeat: (string, int) -> string = { s, times ->
  if times <= 0 then "" else s ++ repeat(s, times - 1)
}

def splitFrom: (string, string, int) -> list(string) = { s, separator, from ->
  def index = indexFrom(s, separator, from)
  if index < 0
  then [substring(s, from, length(s) - from)]
  else __nanyx_list_cons(substring(s, from, index - from), splitFrom(s, separator, index + length(separator)))
}

-- The pieces of `s` between occurrences of `separator`. An empty separator yields `[s]`.
export def split: (string, string) -> list(string) = { s, separator ->
  if length(separator) == 0 then [s] else splitFrom(s, separator, 0)
}

def joinRest: (list(string), string, string) -> string = { pieces, separator, acc ->
  match pieces
  | [] -> acc
  | [piece, ...rest] -> joinRest(rest, separator, (acc ++ separator) ++ piece)
}

-- The `pieces` concatenated with `separator` between each pair.
export def join: (list(string), string) -> string = { pieces, separator ->
  match pieces
  | [] -> ""
  | [first, ...rest] -> joinRest(rest, separator, first)
}

-- The `pieces` concatenated end to end.
export def concat: list(string) -> string = { pieces -> join(pieces, "") }
