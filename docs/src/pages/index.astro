---
import { ArrowRight } from "lucide-react";
import Base from "@/layouts/Base.astro";
import { getNav } from "@/lib/nav";
import { sectionIcon } from "@/lib/icons";

const nav = await getNav();
const gettingStarted = nav.find((s) => s.dir === "getting-started")?.pages[0]?.path ?? "/docs";
---

<Base title="Nanyx docs">
  <div class="min-h-screen bg-background">
    <header class="relative overflow-hidden">
      <div class="absolute inset-0 bg-gradient-to-br from-primary/5 via-transparent to-secondary/5"></div>
      <div class="relative max-w-5xl mx-auto px-6 py-24 md:py-32 text-center">
        <div class="inline-flex items-center gap-2.5 mb-8">
          <div class="h-12 w-12 rounded-xl flex items-center justify-center shadow-lg shadow-primary/25">
            <img src="/nanyx.svg" alt="" width="48" height="48" />
          </div>
          <h1 class="text-4xl md:text-5xl font-bold tracking-tight">Nanyx</h1>
        </div>
        <p class="text-lg md:text-xl text-muted-foreground max-w-2xl mx-auto mb-10 leading-relaxed">
          A type-safe, expressive language for building reliable software.
          <br class="hidden md:block" />
          Simple to learn. Powerful to use.
        </p>
        <div class="flex items-center justify-center gap-4">
          <a
            href={gettingStarted}
            class="inline-flex items-center gap-2 px-6 py-3 rounded-lg bg-primary text-primary-foreground font-medium hover:bg-primary/90 transition-colors shadow-md shadow-primary/20"
          >
            Get Started
            <ArrowRight className="h-4 w-4" />
          </a>
          <a
            href="/docs/tour/variables"
            class="inline-flex items-center gap-2 px-6 py-3 rounded-lg border border-border text-foreground font-medium hover:bg-accent transition-colors"
          >
            Language Tour
          </a>
        </div>

        <div class="mt-16 max-w-lg mx-auto text-left">
          <div class="rounded-xl bg-[#111827] border border-border/50 shadow-2xl overflow-hidden">
            <div class="flex items-center gap-1.5 px-4 py-3 border-b border-white/10">
              <div class="h-3 w-3 rounded-full bg-red-500/70"></div>
              <div class="h-3 w-3 rounded-full bg-yellow-500/70"></div>
              <div class="h-3 w-3 rounded-full bg-green-500/70"></div>
              <span class="ml-2 text-xs text-white/40 font-mono">hello.nx</span>
            </div>
            <pre
              class="p-5 text-sm leading-relaxed font-mono text-white"><code><span class="text-purple-400">import</span> <span class="text-cyan-300">nanyx/io</span>

<span class="text-purple-400">def</span> <span class="text-yellow-300">main</span> = {"{"}
  <span class="text-yellow-300">println</span>(<span class="text-green-400">"Hello, Nanyx! 🚀"</span>)
{"}"}</code></pre>
          </div>
        </div>
      </div>
    </header>

    <section class="max-w-5xl mx-auto px-6 pb-24">
      <div class="grid gap-4 md:grid-cols-2">
        {
          nav.map((section) => {
            const Icon = sectionIcon(section.icon);
            const titles = section.pages.map((p) => p.title);
            return (
              <a
                href={section.pages[0]?.path ?? section.basePath}
                class="group p-6 rounded-xl border border-border hover:border-primary/30 hover:bg-accent/30 transition-all"
              >
                <div class="flex items-start gap-4">
                  <div class="h-10 w-10 rounded-lg bg-accent flex items-center justify-center shrink-0">
                    <Icon className="h-5 w-5 text-primary" />
                  </div>
                  <div>
                    <h2 class="font-semibold mb-1 group-hover:text-primary transition-colors">{section.title}</h2>
                    <p class="text-sm text-muted-foreground">
                      {section.pages.length} {section.pages.length === 1 ? "page" : "pages"} ·{" "}
                      {titles.slice(0, 3).join(", ")}
                      {titles.length > 3 && "..."}
                    </p>
                  </div>
                </div>
              </a>
            );
          })
        }
      </div>
    </section>
  </div>
</Base>
