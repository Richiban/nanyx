{
  "name": "nanyx",
  "displayName": "Nanyx",
  "description": "Nanyx language support: syntax highlighting and diagnostics",
  "publisher": "nanyx",
  "repository": {
    "type": "git",
    "url": "https://github.com/Richiban/nanyx"
  },
  "license": "MIT",
  "version": "0.2.0",
  "icon": "img/nanyx.png",
  "galleryBanner": {
    "color": "#5b5bf2",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.76.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:nanyx"
  ],
  "contributes": {
    "languages": [
      {
        "id": "nanyx",
        "aliases": [
          "Nanyx",
          "nanyx"
        ],
        "extensions": [
          ".nyx"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "nanyx",
        "scopeName": "source.nanyx",
        "path": "./syntaxes/nanyx.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "nanyx.downloadCompiler",
        "title": "Nanyx: Download the compiler"
      },
      {
        "command": "nanyx.restartServer",
        "title": "Nanyx: Restart the language server"
      }
    ],
    "configuration": {
      "title": "Nanyx",
      "properties": {
        "nanyx.path": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to the `nanyx` executable (the compiler, which is also the language server). Leave empty to use the `nanyx` on PATH, or to download a release into the extension's storage."
        },
        "nanyx.compilerVersion": {
          "type": "string",
          "default": "",
          "markdownDescription": "The compiler release to download when no `nanyx` is found. Leave empty for the version this extension was built for."
        },
        "nanyx.downloadUrl": {
          "type": "string",
          "default": "",
          "markdownDescription": "Where to download the compiler from. `${version}`, `${rid}` (e.g. `win-x64`) and `${ext}` (`zip` or `tar.gz`) are substituted. Leave empty for the GitHub releases of Richiban/nanyx."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "@types/vscode": "^1.76.0",
    "typescript": "^5.5.4"
  }
}
