<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <WarningsAsErrors>0025</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Runner.fs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Embeds the Wasmtime engine; the package ships the native library for every platform the CLI is published for. -->
    <PackageReference Include="Wasmtime" Version="48.0.2" />
  </ItemGroup>

</Project>
