<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <!-- The binary users run is called `nanyx`; the project keeps its own name. -->
    <AssemblyName>nanyx</AssemblyName>
    <RootNamespace>NanyxCompiler.Cli</RootNamespace>
    <!-- Bumped for each release; when main has a Version with no compiler/<version> tag, the compiler workflow releases it. -->
    <Version>0.7.0</Version>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsAsErrors>0025</WarningsAsErrors>
    <!--
      Wasmtime recovers from WebAssembly traps (e.g. `unreachable`) by restoring a context that the CET
      shadow stack rejects, so a CET-compatible apphost fail-fasts (0xC0000409) instead of throwing
      (bytecodealliance/wasmtime-dotnet#374). Keep the process off the shadow stack until that is fixed.
    -->
    <CetCompat>false</CetCompat>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Nanyx.Compiler\NanyxCompiler.fsproj" />
    <ProjectReference Include="..\Nanyx.Compiler.Wasm\Nanyx.Compiler.Wasm.fsproj" />
    <ProjectReference Include="..\Nanyx.Compiler.Runtime\Nanyx.Compiler.Runtime.fsproj" />
    <ProjectReference Include="..\Nanyx.LanguageServer\Nanyx.LanguageServer.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Consolo" Version="0.33.0" />
  </ItemGroup>

</Project>
