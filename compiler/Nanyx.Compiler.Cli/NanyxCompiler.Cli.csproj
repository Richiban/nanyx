<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <!-- The binary users run is called `nanyx`; the project keeps its own name. -->
    <AssemblyName>nanyx</AssemblyName>
    <RootNamespace>NanyxCompiler.Cli</RootNamespace>
    <!-- Bumped for each release; the compiler workflow checks that a compiler/<version> tag matches it. -->
    <Version>0.1.0</Version>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsAsErrors>0025</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Nanyx.Compiler\NanyxCompiler.fsproj" />
    <ProjectReference Include="..\Nanyx.Compiler.Wasm\Nanyx.Compiler.Wasm.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Consolo" Version="0.12.0" />
  </ItemGroup>

</Project>
