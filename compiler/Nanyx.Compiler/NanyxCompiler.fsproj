<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsAsErrors>0025</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Diagnostics.fs" />
    <Compile Include="TypedAst.fs" />
    <Compile Include="TypeEnv.fs" />
    <Compile Include="Constraints.fs" />
    <Compile Include="Unifier.fs" />
    <Compile Include="Infer.fs" />
    <Compile Include="Builtins.fs" />
    <Compile Include="Library.fs" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The standard library (the `nanyx` package) is Nanyx source in stdlib/nanyx at the repository root.
      It is embedded here so the published single-file `nanyx` binary carries it: one resource per
      module, named "nanyx/<module>.nyx" (see StandardLibrary in Builtins.fs).
    -->
    <EmbeddedResource Include="..\..\stdlib\nanyx\*.nyx" LogicalName="nanyx/%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Nanyx.Parser\Nanyx.Parser.fsproj" />
  </ItemGroup>

</Project>
